{
  "name": "crew-desk-community",
  "version": "0.1.0",
  "description": "A local dashboard and queue that runs Claude Code workers on a Claude subscription or on low-cost DeepSeek and Kimi API keys, with budgets, pinned snapshots and reviewable diffs.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mani-kanasani/crew-desk-community.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "crew": "node bin/crew.mjs",
    "mcp": "node bin/mcp.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.8.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.1"
  }
}

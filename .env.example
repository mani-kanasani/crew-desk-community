# Copy to .env.local and paste credentials there. Never commit the private copy.
# The backend loads .env first, then .env.local; existing shell variables win.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
# Claude Code uses kimi-k3[1m]; max is a reasoning setting, not a model suffix.
KIMI_MODEL=kimi-k3[1m]
KIMI_EFFORT=max
# DeepSeek V4.1 Flash. "DeepSeek V1" is not a verified model ID.
DEEPSEEK_MODEL=deepseek-flash
# Claude subscription workers use `claude auth login` separately.
HARNESS_PORT=4317
